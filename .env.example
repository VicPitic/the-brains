# Copy to .env.local. Every value is optional unless the step you run needs it.

# --- Pipeline (pipeline/*.mjs): building brains ---
SCRAPECREATORS_API_KEY=        # X profile + top posts, YouTube transcript fallback (scrapecreators.com)
CONTEXT_DEV_API_KEY=           # site maps, web search and essay scraping (context.dev)
RAPIDAPI_KEY_MEDIA=            # RapidAPI key subscribed to yt-api and youtube-transcript3
RAPIDAPI_KEY_SOCIAL=           # RapidAPI key subscribed to twitter154 (optional)
APIFY_TOKEN=                   # apidojo/tweet-scraper for the deeper X pull (~$0.40 per 1,000 posts)
# THE_BRAINS_LINKEDIN_POSTS_ACTOR=johnvc/linkedin-posts-api
# Summaries and notes run through the Claude Code CLI (`claude -p`), so no Anthropic key is needed here.

# --- Server (server/*.ts): website + MCP ---
PORT=8790
DATABASE_URL=                  # Postgres. Without it the MCPs are open and nothing is tracked.
AUTH_SECRET=                   # long random string, peppers code and token hashes
ADMIN_PASSWORD=                # /admin (HTTP Basic auth, any username)
PUBLIC_BASE_URL=               # e.g. https://brains.ceo
MCP_BASE_URL=                  # e.g. https://mcp.brains.ceo (OAuth issuer + MCP host)
EMAIL_FROM="The Brains <hello@example.com>"
RESEND_API_KEY=                # sends the 6-digit sign-in codes (preferred)
SMTP_HOST=                     # or plain SMTP, e.g. mail.spacemail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
REVIEWER_LOGIN=                 # optional "email:123456" static sign-in for app-directory reviewers
BEHIND_MCP_GATEWAY=             # "true" when an MCP gateway (e.g. Manufact) fronts the server
CLIENT_IP_HEADER=               # header with the real client IP behind multi-hop proxies, e.g. cf-connecting-ip
